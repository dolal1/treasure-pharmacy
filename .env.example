# Unified env for `docker compose up` — every service reads what it needs.
# Copy to .env; the defaults below work out of the box for local development.

# --- Database ---
POSTGRES_DB=pharmacy
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=pharmacy

# --- Backend (Django) ---
SECRET_KEY=dev-only-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Hidden back-office path — set to something unguessable in production
ADMIN_URL=back-office/
PHARMACY_INBOX_EMAIL=bookings@treasurepharmacy.example
DEFAULT_FROM_EMAIL=Treasure Pharmacy <no-reply@treasurepharmacy.example>

# First boot auto-creates this back-office login
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@treasurepharmacy.example
DJANGO_SUPERUSER_PASSWORD=admin1234

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# DATABASE_URL is intentionally not set here: docker compose points the
# backend at the db container. Only set it when running the backend
# outside Docker (see backend/.env.example).
